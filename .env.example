# Local Postgres — Docker (`docker compose -f docker-compose.db.yml up -d`)
POSTGRES_URL_LOCAL=postgresql://oczki:oczki@localhost:5433/oczki

# Production (Vercel Neon) — copy from Vercel dashboard; use only with `pnpm seed:production`
# POSTGRES_URL_VERCEL=postgresql://...

# Vercel Blob (legacy) — only used when R2_* is NOT fully set.
# Ignored when POSTGRES_URL points at localhost (local files use public/media/).
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare R2 (preferred production media storage on Vercel — S3-compatible API).
# When all R2_* are set, Payload uses R2 and ignores BLOB_READ_WRITE_TOKEN.
# R2_BUCKET=oczki-foto-media
# R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Used to encrypt JWT tokens
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used to configure CORS, format links and more. No trailing slash
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Secret used to authenticate cron jobs
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Used to validate preview requests
PREVIEW_SECRET=979762300c7ae6eef671e711d21b11225334eb0c55685574bd64eb928feb122d

# Optional — loaded only after user consents and CMS category flags are enabled.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Local dev only (pnpm dev) — show cookie banner without enabling it in CMS.
# Set to true, restart dev server, test in incognito. Ignored in production builds.
COOKIE_CONSENT_DEV_PREVIEW=false
# When DEV_PREVIEW is true, also expose analytics/marketing toggles in preferences panel.
COOKIE_CONSENT_DEV_PREVIEW_CATEGORIES=false
